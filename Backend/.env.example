# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/tmdb_platform1

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# TMDB API (get Read Access Token from https://developer.themoviedb.org/settings/api)
TMDB_BEARER=your_tmdb_read_access_token_here
TMDB_BASE=https://api.themoviedb.org/3

# Redis (optional - caching works without it but is disabled)
REDIS_URL=redis://localhost:6379

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
